# Replace domains and certificate paths. Serve only build outputs, never source directories.
# These blocks belong inside nginx's http {} context.
limit_req_zone $binary_remote_addr zone=ktv_public:10m rate=10r/s;
server {
    listen 443 ssl;
    server_name order.example.com;
    ssl_certificate /etc/ktv/tls/fullchain.pem;
    ssl_certificate_key /etc/ktv/tls/privkey.pem;
    root /srv/ktv/mobile;
    client_max_body_size 3m;
    location / { try_files $uri $uri/ /index.html; }
    location /ktv-api/ {
        limit_req zone=ktv_public burst=30 nodelay;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        # Let Spring's CORS filter reflect the configured allow-list. Do not
        # add a fixed Access-Control-Allow-Origin header here.
    }
    location ~ /\. { deny all; }
}
server {
    listen 443 ssl;
    server_name admin.example.com;
    ssl_certificate /etc/ktv/tls/fullchain.pem;
    ssl_certificate_key /etc/ktv/tls/privkey.pem;
    root /srv/ktv/admin;
    client_max_body_size 10m;
    location / { try_files $uri $uri/ /index.html; }
    location /prod-api/ {
        proxy_pass http://127.0.0.1:8080/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
    location ~ /\. { deny all; }
}
server {
    listen 443 ssl;
    server_name api.example.com;
    ssl_certificate /etc/ktv/tls/fullchain.pem;
    ssl_certificate_key /etc/ktv/tls/privkey.pem;
    root /srv/ktv;
    client_max_body_size 3m;
    location /ktv-api/ {
        limit_req zone=ktv_public burst=30 nodelay;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
    # The API host also exposes the admin build so operators can use one
    # configured host for the console and the service. Business calls continue
    # to use /ktv-api/ and remain protected by the backend authentication.
    location /admin/ { try_files $uri $uri/ /admin/index.html; }
    location = / {
        return 302 /admin/;
    }
    location / { return 404; }
}
